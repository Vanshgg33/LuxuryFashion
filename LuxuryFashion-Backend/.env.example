# Environment Configuration Example

# Application
ENVIRONMENT=production
PORT=8080
FRONTEND_URL=https://rangeelaboutique.com
BACKEND_URL=https://api.rangeelaboutique.com
ALLOWED_ORIGINS=https://rangeelaboutique.com

# Database
DATABASE_URL=jdbc:mysql://localhost:3306/rangeela_DB
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
DB_POOL_SIZE=20
DB_MIN_IDLE=10

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRATION=86400000
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# File Storage
PRODUCT_IMAGE_PATH=/app/uploads/products
PROFILE_IMAGE_PATH=/app/uploads/profiles
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=25MB

# Logging
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN