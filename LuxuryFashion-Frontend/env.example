# Development: Local backend URL
VITE_API_BASE=http://localhost:8080

# Production: Set this to your backend Vercel URL in Vercel project settings
# Example: VITE_API_BASE=https://your-backend-project.vercel.app
# 
# To set in Vercel:
# 1. Go to your frontend project in Vercel
# 2. Settings → Environment Variables
# 3. Add: VITE_API_BASE = https://your-backend-project.vercel.app
# 4. Redeploy

